{
  "name": "xray-schema",
  "version": "0.1.0",
  "description": "Hand-written zod schemas for Xray-core configs, held to what each Xray release decodes, plus JSON Schema generated from them.",
  "license": "MIT",
  "author": "Sergey Pinus (bropines)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bropines/xray-schema.git"
  },
  "homepage": "https://github.com/bropines/xray-schema#readme",
  "bugs": "https://github.com/bropines/xray-schema/issues",
  "keywords": [
    "xray",
    "xray-core",
    "zod",
    "json-schema",
    "config",
    "vless",
    "reality"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*",
    "./fixtures/core-keys.json": "./fixtures/core-keys.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "fixtures/core-keys.json",
    "versions.json",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "core-keys": "bun run scripts/core-keys.ts",
    "schema:build": "bun run scripts/build-json-schema.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "ajv": "8.17.1",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
